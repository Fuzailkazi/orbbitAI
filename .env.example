# Orbbit environment variables
# Copy to .env.local (`cp .env.example .env.local`) and fill in real values.
# Never commit .env.local. Everything without the NEXT_PUBLIC_ prefix stays on the server.

# --- Supabase ---------------------------------------------------------------
# Project URL and anon key (Project Settings -> API). Safe to expose to the browser;
# every read through these goes through Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY: used by authenticated route handlers and the eval
# runner for writes, and by the seed scripts. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenRouter -------------------------------------------------------------
# Single gateway for every model call (https://openrouter.ai/keys).
# Live runs are restricted to `:free` models, so a free account is enough.
OPENROUTER_API_KEY=

# Optional. Judge model for llm_judge benchmarks (MT-Bench, AlpacaEval).
# Only honored when it is a `:free` model id; otherwise the default
# meta-llama/llama-3.3-70b-instruct:free is used.
JUDGE_MODEL=

# --- Guest demo -------------------------------------------------------------
# HMAC secret for the signed guest-demo cookie (at least 16 characters).
# Generate one with: openssl rand -base64 32
# If unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY; with neither set,
# the guest demo is disabled (fails closed).
GUEST_DEMO_SECRET=

# --- App --------------------------------------------------------------------
# Public base URL. Used for metadata (Open Graph) and as the HTTP-Referer sent to OpenRouter.
NEXT_PUBLIC_APP_URL=http://localhost:3000
